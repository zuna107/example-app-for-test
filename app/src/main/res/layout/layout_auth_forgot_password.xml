<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerForgotPassword"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvForgotSubtitle"
        style="@style/Widget.Shadcn.Description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/forgot_desc" />

    <!-- Success Banner -->
    <LinearLayout
        android:id="@+id/llForgotSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/cd_security_verified"
            android:src="@drawable/ic_check" />

        <TextView
            android:id="@+id/tvForgotSuccessMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reset_link_sent_success"
            android:textColor="@color/status_success"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Email Field -->
    <TextView
        style="@style/Widget.Shadcn.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_email" />

    <EditText
        android:id="@+id/etForgotEmail"
        style="@style/Widget.Shadcn.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:autofillHints="emailAddress"
        android:hint="@string/hint_email"
        android:imeOptions="actionDone"
        android:inputType="textEmailAddress"
        android:maxLines="1" />

    <!-- Error Banner -->
    <TextView
        android:id="@+id/tvForgotError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge"
        android:padding="8dp"
        android:textColor="@color/status_destructive"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Send Reset Button -->
    <Button
        android:id="@+id/btnForgotSubmit"
        style="@style/Widget.Shadcn.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="@string/btn_send_reset_link" />

    <!-- Back to Sign In Button -->
    <Button
        android:id="@+id/btnBackToSignIn"
        style="@style/Widget.Shadcn.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_arrow_left"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/back_to_sign_in" />

</LinearLayout>
