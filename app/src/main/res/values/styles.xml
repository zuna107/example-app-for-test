<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label Style -->
    <style name="Widget.Shadcn.Label" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Subtitle / Muted Description Style -->
    <style name="Widget.Shadcn.Description" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Input Field Style -->
    <style name="Widget.Shadcn.EditText" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Primary Button Style -->
    <style name="Widget.Shadcn.Button.Primary" parent="">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary / Outline Button Style -->
    <style name="Widget.Shadcn.Button.Secondary" parent="">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
